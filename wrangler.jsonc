{
  // 르네 콘솔 — Cloudflare Workers (정적 화면 + API + 크론). Pages가 아닌 이유: 예약 게시 크론이 Workers에만 있다.
  // 비밀은 여기 두지 않는다 → Cloudflare 대시보드 › pensieve-instagram › 설정 › 빌드 › 변수 및 암호(비밀)
  //   배포 명령 node scripts/deploy.mjs 가 배포 때마다 런타임 비밀로 옮긴다(설정 › 변수 및 비밀에 직접 넣어도 된다)
  //   PASSWORDS           "이름=암호" 를 쉼표로 여러 개 (BM·브레인 스토밍과 같은 형식) — 어느 암호든 같은 르네 콘솔
  //   ANTHROPIC_API_KEY   Claude 키 (BM·브레인 스토밍에 쓴 키 그대로)
  //   IG_APP_SECRET       Meta 앱 › 앱 설정 › 기본 설정 의 앱 시크릿 코드 (Instagram 은 Unified login — Meta 앱 자체의 ID·시크릿을 쓴다)
  //   THREADS_APP_SECRET  Meta 앱 › 이용 사례 › Threads API 액세스 › 설정 의 Threads 앱 시크릿 코드
  //   SESSION_SECRET      Meta 토큰 봉인용 긴 임의 문자열(16자 이상, 필수) — 암호를 바꿔도 연결이 살아 있게
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pensieve-instagram",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // SPA 모드는 브라우저 이동 요청(OAuth 되돌아오기 등)을 Worker 보다 먼저 index.html 로 받아 버린다 → API·미디어는 Worker 먼저
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/media/*"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // 크론 하나 — 1분마다 예약 게시 + 자동 DM(댓글·스토리 답장). 09:00 KST 첫 틱은 지표·토큰 갱신·정리(무료 요금제 크론 수를 아낀다)
    "crons": ["* * * * *"]
  },
  "vars": {
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "CLAUDE_EFFORT": "medium",
    "GRAPH_VERSION": "v26.0",
    // 앱 ID·구성 ID 는 비밀이 아니다(로그인 주소에 그대로 드러난다)
    "IG_APP_ID": "1457444973034330",
    "IG_CONFIG_ID": "1429584209291987", // 이용 사례 › Instagram API › API setup with Unified login › 구성 「Instagram API(통합 로그인)」 — 토큰 만료 없음
    "THREADS_APP_ID": "1431859891799607",
    "PUBLIC_ORIGIN": "https://instagram.pensieve.kr"
  },
  // 저장소 — 표는 첫 요청 때 저절로 만든다(lib/db.js)
  "d1_databases": [
    { "binding": "DB", "database_name": "instagram", "database_id": "9f6280ac-d612-43ce-9c6a-854161895b5d" }
  ],
  // 르네 카드·소재(사진·영상) — Workers KV(무료 요금제 포함, 카드 불필요). /media/<key> 로 공개 서빙(Meta가 가져간다)
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "cedae53437a440a886e489e77a9b0365" }
  ],
  // 르네 카드 HTML → JPEG(Browser Rendering). 없으면 카드는 「다시 찍기」로 남고 사진 소재는 그대로 쓴다
  "browser": { "binding": "BROWSER" }
}
